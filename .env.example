# Copy to .env.local and fill in your Clerk development keys.
# Never put secret keys in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Neon: pooled URL for application queries, direct URL for schema changes.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Server-only DeepSeek key for AI chat.
DEEPSEEK_API_KEY=

# Next.js server: Trigger.dev environment key.
TRIGGER_SECRET_KEY=
# Configure DATABASE_URL and DEEPSEEK_API_KEY in the Trigger.dev worker environment too.
